.shell powershell
.pause alt + shift + p
.pause_hook & "$env:USERPROFILE\bin\wm.ps1" pause-hook

# Focus directional windows (Instant native socket navigation)
alt + left : komorebic focus left
alt + right : komorebic focus right
alt + up : komorebic focus up
alt + down : komorebic focus down

# Workspace navigation (Instant zero-latency native socket calls)
alt + j : komorebic cycle-workspace previous
alt + k : komorebic cycle-workspace next
ctrl + alt + left : komorebic cycle-workspace previous
ctrl + alt + right : komorebic cycle-workspace next

# Move focused windows
alt + shift + up : komorebic move up
alt + shift + down : komorebic move down
alt + shift + left : komorebic move left
alt + shift + right : komorebic move right
alt + shift + j : komorebic cycle-move-to-workspace previous
alt + shift + k : komorebic cycle-move-to-workspace next
ctrl + alt + shift + left : komorebic cycle-move-to-workspace previous
ctrl + alt + shift + right : komorebic cycle-move-to-workspace next

# Percentage-based resize and modal resize mode
alt + h : & "$env:USERPROFILE\bin\wm.ps1" resize width -5
alt + l : & "$env:USERPROFILE\bin\wm.ps1" resize width 5
alt + u : & "$env:USERPROFILE\bin\wm.ps1" resize height 5
alt + i : & "$env:USERPROFILE\bin\wm.ps1" resize height -5
alt + y : & "$env:USERPROFILE\bin\wm.ps1" resize-mode

# Presets (Agentic pair-programming & Grid modes)
alt + p : & "$env:USERPROFILE\bin\wm.ps1" preset pair
alt + g : & "$env:USERPROFILE\bin\wm.ps1" preset grid

# Layout and focused-window state (Instant 2ms direct calls)
alt + shift + space : komorebic toggle-window-container-behaviour
ctrl + alt + space : & "$env:USERPROFILE\bin\wm.ps1" layout next
ctrl + alt + shift + space : & "$env:USERPROFILE\bin\wm.ps1" layout previous
alt + oem_5 : komorebic toggle-workspace-layer
alt + space : komorebic toggle-float
alt + t : komorebic toggle-float
alt + m : komorebic manage
alt + shift + m : komorebic unmanage
alt + f : komorebic toggle-monocle
alt + n : komorebic minimize
alt + q : komorebic close

# Lifecycle and redraw
alt + shift + e : & "$env:USERPROFILE\bin\wm.ps1" stop
alt + shift + back : & "$env:USERPROFILE\bin\wm.ps1" restart
alt + shift + x : & "$env:USERPROFILE\bin\wm.ps1" restart
alt + shift + r : & "$env:USERPROFILE\bin\wm.ps1" reload
alt + shift + w : komorebic retile

# Application launchers
alt + return : & "$env:USERPROFILE\bin\wm.ps1" launch terminal
alt + b : & "$env:USERPROFILE\bin\wm.ps1" launch firefox
alt + e : & "$env:USERPROFILE\bin\wm.ps1" launch explorer
alt + o : & "$env:USERPROFILE\bin\wm.ps1" launch obsidian
alt + r : & "$env:USERPROFILE\bin\wm.ps1" launch flow
alt + c : & "$env:USERPROFILE\bin\wm.ps1" launch cursor

# Active and recent workspace navigation
alt + s : & "$env:USERPROFILE\bin\wm.ps1" active-workspace next
alt + a : & "$env:USERPROFILE\bin\wm.ps1" active-workspace previous
alt + d : & "$env:USERPROFILE\bin\wm.ps1" last-workspace

# Named workspace focus (Instant 2ms direct switch)
alt + 1 : komorebic focus-named-workspace 1
alt + 2 : komorebic focus-named-workspace 2
alt + 3 : komorebic focus-named-workspace 3
alt + 4 : komorebic focus-named-workspace 4
alt + 5 : komorebic focus-named-workspace 5
alt + 6 : komorebic focus-named-workspace 6
alt + 7 : komorebic focus-named-workspace 7
alt + 8 : komorebic focus-named-workspace 8
alt + 9 : komorebic focus-named-workspace 9

# Move the current workspace between monitors
alt + shift + a : & "$env:USERPROFILE\bin\wm.ps1" move-workspace left
alt + shift + f : & "$env:USERPROFILE\bin\wm.ps1" move-workspace right
alt + shift + d : & "$env:USERPROFILE\bin\wm.ps1" move-workspace up
alt + shift + s : & "$env:USERPROFILE\bin\wm.ps1" move-workspace down

# Send to a named workspace without following
alt + shift + 1 : komorebic move-to-named-workspace 1
alt + shift + 2 : komorebic move-to-named-workspace 2
alt + shift + 3 : komorebic move-to-named-workspace 3
alt + shift + 4 : komorebic move-to-named-workspace 4
alt + shift + 5 : komorebic move-to-named-workspace 5
alt + shift + 6 : komorebic move-to-named-workspace 6
alt + shift + 7 : komorebic move-to-named-workspace 7
alt + shift + 8 : komorebic move-to-named-workspace 8
alt + shift + 9 : komorebic move-to-named-workspace 9

# Move to a named workspace and follow
alt + ctrl + 1 : komorebic move-to-named-workspace 1 --follow
alt + ctrl + 2 : komorebic move-to-named-workspace 2 --follow
alt + ctrl + 3 : komorebic move-to-named-workspace 3 --follow
alt + ctrl + 4 : komorebic move-to-named-workspace 4 --follow
alt + ctrl + 5 : komorebic move-to-named-workspace 5 --follow
alt + ctrl + 6 : komorebic move-to-named-workspace 6 --follow
alt + ctrl + 7 : komorebic move-to-named-workspace 7 --follow
alt + ctrl + 8 : komorebic move-to-named-workspace 8 --follow
alt + ctrl + 9 : komorebic move-to-named-workspace 9 --follow

# Display scaling
ctrl + alt + shift + up : & "$env:USERPROFILE\bin\change_scale.ps1" up
ctrl + alt + shift + down : & "$env:USERPROFILE\bin\change_scale.ps1" down
